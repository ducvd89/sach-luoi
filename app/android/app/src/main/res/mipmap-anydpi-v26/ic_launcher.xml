<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 trở lên tự bo hình icon theo kiểu của từng máy (tròn, vuông tròn
     góc, hình giọt nước). Tách nền và hình ra hai lớp để máy bo phần nền, còn
     quyển sách nằm gọn trong vùng an toàn ở giữa chứ không bị cắt mất góc. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
